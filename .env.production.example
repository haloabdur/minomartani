#--------------------------------------------------------------------
# PRODUCTION ENVIRONMENT TEMPLATE
#
# Copy this to `.env` on the production server and fill in the real
# values. Never commit the filled-in `.env` - it's gitignored.
#
# See DEPLOYMENT.md for the full deployment checklist.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'https://minomartani.com/'
# The 'forcehttps' filter is enabled by default (app/Config/Filters.php
# $required['before']) - the site MUST be served over TLS in production
# or every request will redirect-loop. Get a real TLS cert first.

# Tenant subdomains (every RT and RW) are NOT settable here - CI4 can only
# override an array .env property when the config class's default value
# already has matching indexes (see BaseConfig::initEnvValue()), and
# App::$allowedHostnames defaults to []. app.allowedHostnames.0 = '...'
# here is silently ignored. Edit the $allowedHostnames array directly in
# app/Config/App.php instead and deploy - every subdomain not listed there
# falls back to app.baseURL's host for ALL generated URLs (site_url(),
# redirect()->to(), form_open()...), so visitors get silently bounced to
# the baseURL domain and can't log in. New tenants added via admin/tenants
# need a new entry in app/Config/App.php too (not automatic).

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = REPLACE_WITH_PROD_DB_NAME
database.default.username = REPLACE_WITH_PROD_DB_USER
database.default.password = REPLACE_WITH_PROD_DB_PASSWORD
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# Generate on the production server itself with `php spark key:generate`
# - do NOT reuse the development key. Keep this value secret; Shield's
# remember-me tokens and encrypted session data depend on it.
# encryption.key =

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null

#--------------------------------------------------------------------
# COOKIE
#--------------------------------------------------------------------

# Must be the wildcard parent of every RT/RW subdomain (leading dot),
# e.g. '.minomartani.com' for rt29.minomartani.com, rt30.minomartani.com,
# etc. Without this, the session cookie is host-only: a superadmin
# switching tenants (Admin\Dashboard::switchTenant(), which redirects
# across subdomains so TenantFilter's per-host auto-scoping picks up
# the new RT) gets logged out mid-switch instead of landing on the new
# RT's dashboard. Confirm this matches the domain actually serving the
# RT subdomains in app/Config/App.php::$allowedHostnames - NOT
# app.baseURL above, which may be a different legacy domain.
cookie.domain = '.minomartani.com'

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

# Default threshold (4) logs errors/warnings/notices - fine for
# production. Raise to 1 (errors only) if disk space on the host is
# tight; the app doesn't currently need debug-level (9) logging live.
# logger.threshold = 4

#--------------------------------------------------------------------
# CLOUDFLARE TURNSTILE (login form)
#--------------------------------------------------------------------

# Site Key and Secret Key come from the Cloudflare dashboard - Turnstile
# widget settings. They are two DIFFERENT values (site key is public,
# embedded in the login page; secret key is server-side only, used by
# app/Filters/TurnstileFilter.php to call Cloudflare's siteverify API).
# If secretKey is blank or wrong, every login attempt is blocked.
# turnstile.enabled defaults to true when CI_ENVIRONMENT = production
# (see app/Config/Turnstile.php) - no need to set it here unless you
# want to force it off.
turnstile.siteKey = REPLACE_WITH_TURNSTILE_SITE_KEY
turnstile.secretKey = REPLACE_WITH_TURNSTILE_SECRET_KEY

#--------------------------------------------------------------------
# DB SYNC (Admin\DbSync push/pull API)
#--------------------------------------------------------------------

# Shared secret authenticating POST /api/dbsync (used by Admin\DbSync
# push/pull from the local dev machine). Must be IDENTICAL to the
# dbsync.token in the local .env that syncs against this server, and
# long/random - this endpoint can execute a full SQL dump. The local
# (non-production) .env additionally needs dbsync.productionURL pointing
# at this site; that variable is unused on production itself.
dbsync.token = REPLACE_WITH_LONG_RANDOM_TOKEN
